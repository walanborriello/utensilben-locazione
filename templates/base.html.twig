<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}UtensilBen - Localizzazione materiali{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/favicon_io/favicon-32x32.png') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('images/favicon_io/favicon-16x16.png') }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('images/favicon_io/apple-touch-icon.png') }}">
    <link rel="manifest" href="{{ asset('images/favicon_io/site.webmanifest') }}">
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body>
    <header class="ub-header">
        <a href="{{ path('app_home') }}" class="ub-header__logo">
            <img src="{{ asset('images/logo-utensilben.png') }}" alt="UtensilBen">
        </a>
        <nav class="ub-header__nav">
            <a href="{{ path('admin_dashboard') }}">Gestione</a>
        </nav>
    </header>

    <main class="ub-main">
        {% block body %}{% endblock %}
    </main>

    <footer class="ub-footer">
        UtensilBen — sistema interno di localizzazione materiali · Made by <a href="https://www.linkedin.com/in/francesco-borriello/" target="_blank" rel="noopener">F.Borriello</a>
    </footer>
</body>
</html>
