{% extends 'admin/_layout.html.twig' %}

{% block title %}File - UtensilBen{% endblock %}

{% block admin_body %}
    <div class="ub-admin__header">
        <h1>File</h1>
        <a href="{{ path('admin_fila_new') }}" class="ub-btn ub-btn--primary">+ Nuova fila</a>
    </div>

    <div class="ub-disclaimer">
        Le file rappresentano gli scaffali fisici del magazzino. Per ognuna scegli se è "unica" (un solo lato) o "divisa" (lato sinistro e destro): al salvataggio vengono generate automaticamente le aree corrispondenti, che non si creano mai a mano. Le aree generate compaiono nella scheda di ogni fila.
    </div>

    <form method="get" class="ub-filters">
        <input type="text" name="q" value="{{ q }}" placeholder="Cerca per codice o nome...">
        <select name="tipo">
            <option value="">Tutti i tipi</option>
            {% for tipo in tipiFila %}
                <option value="{{ tipo.value }}" {{ tipoParam == tipo.value ? 'selected' }}>{{ tipo.label }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="ub-btn">Filtra</button>
        {% if q or tipoParam %}<a href="{{ path('admin_fila_index') }}" class="ub-btn ub-btn--small">Azzera</a>{% endif %}
    </form>

    {% if file is empty %}
        <div class="ub-empty-state">Nessuna fila trovata.</div>
    {% else %}
        <div class="ub-cards" data-ub-paginazione data-per-pagina="5" data-per-pagina-desktop="6">
            {% for fila in file %}
                <div class="ub-card" data-ub-paginazione-item>
                    <div class="ub-card__row">
                        <span class="ub-card__label">Codice</span>
                        <span class="ub-card__value">{{ fila.codice }}</span>
                    </div>
                    <div class="ub-card__row">
                        <span class="ub-card__label">Nome</span>
                        <span class="ub-card__value">{{ fila.nome }}</span>
                    </div>
                    <div class="ub-card__row">
                        <span class="ub-card__label">Tipo</span>
                        <span class="ub-card__value"><span class="ub-badge">{{ fila.tipo.label }}</span></span>
                    </div>
                    <div class="ub-card__row">
                        <span class="ub-card__label">Aree generate</span>
                        <span class="ub-card__value">{{ fila.aree|map(area => area.lato.labelBreve)|join(', ')|default('—') }}</span>
                    </div>
                    <div class="ub-card__actions">
                        <a href="{{ path('admin_fila_edit', {id: fila.id}) }}" class="ub-btn ub-btn--small">Modifica</a>
                        <form method="post" action="{{ path('admin_fila_delete', {id: fila.id}) }}" onsubmit="return confirm('Eliminare questa fila?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-fila-' ~ fila.id) }}">
                            <button type="submit" class="ub-btn ub-btn--small ub-btn--danger">Elimina</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
            <div class="ub-paginazione__controlli" data-ub-paginazione-controlli></div>
        </div>
    {% endif %}
{% endblock %}
