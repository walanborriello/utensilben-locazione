{% extends 'admin/_layout.html.twig' %}

{% block title %}File - UtensilBen{% endblock %}

{% block admin_body %}
    <div class="ub-admin__header">
        <h1>File</h1>
        <a href="{{ path('admin_fila_new') }}" class="ub-btn ub-btn--primary">+ Nuova fila</a>
    </div>

    <div class="ub-disclaimer">
        Ogni fila è una lettera (A-L, niente J/K) su un piano dell'edificio. Al salvataggio vengono generate automaticamente le sezioni (a,b,c,e,f,g — la "d" solo per l'ultima fila, dove il corridoio finisce) e i 4 ripiani di ciascuna: non si creano mai a mano.
    </div>

    <form method="get" class="ub-filters">
        <input type="text" name="q" value="{{ q }}" placeholder="Cerca per lettera o piano...">
        <select name="piano">
            <option value="">Tutti i piani</option>
            {% for piano in piani %}
                <option value="{{ piano.id }}" {{ pianoId == piano.id ? 'selected' }}>{{ piano.nome }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="ub-btn">Filtra</button>
        {% if q or pianoId %}<a href="{{ path('admin_fila_index') }}" class="ub-btn ub-btn--small">Azzera</a>{% endif %}
    </form>

    {% if file is empty %}
        <div class="ub-empty-state">Nessuna fila trovata.</div>
    {% else %}
        <div class="ub-cards" data-ub-paginazione data-per-pagina="5" data-per-pagina-desktop="6">
            {% for fila in file %}
                <div class="ub-card" data-ub-paginazione-item>
                    <div class="ub-card__row">
                        <span class="ub-card__label">Piano</span>
                        <span class="ub-card__value">{{ fila.piano }}</span>
                    </div>
                    <div class="ub-card__row">
                        <span class="ub-card__label">Lettera</span>
                        <span class="ub-card__value"><span class="ub-badge">{{ fila.lettera }}</span></span>
                    </div>
                    {% if fila.primaFila or fila.ultimaFila %}
                        <div class="ub-card__row">
                            <span class="ub-card__label">Note</span>
                            <span class="ub-card__value">{{ fila.primaFila ? 'Prima fila' : 'Ultima fila' }}</span>
                        </div>
                    {% endif %}
                    <div class="ub-card__row">
                        <span class="ub-card__label">Sezioni</span>
                        <span class="ub-card__value">{{ fila.sezioni|map(sezione => sezione.lettera)|join(', ')|default('—') }}</span>
                    </div>
                    <div class="ub-card__actions">
                        <a href="{{ path('admin_fila_edit', {id: fila.id}) }}" class="ub-btn ub-btn--small">Modifica</a>
                        <form method="post" action="{{ path('admin_fila_delete', {id: fila.id}) }}" onsubmit="return confirm('Eliminare questa fila?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-fila-' ~ fila.id) }}">
                            <button type="submit" class="ub-btn ub-btn--small ub-btn--danger">Elimina</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
            <div class="ub-paginazione__controlli" data-ub-paginazione-controlli></div>
        </div>
    {% endif %}
{% endblock %}
